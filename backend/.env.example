# Server
NODE_ENV=development
PORT=3003

# Database (MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pdfqr_user
DB_PASSWORD=changeme
DB_NAME=pdfqr_dashboard
DB_CONNECTION_LIMIT=10

# JWT
JWT_SECRET=changeme_generate_random_64_char_string
JWT_EXPIRES_IN=7d

# Guest cookie signing (cookie-parser secret) - HARUS beda dari JWT_SECRET
COOKIE_SECRET=changeme_generate_another_random_string

# Guest quota
GUEST_QUOTA_LIMIT=5

# File storage
STORAGE_DIR=./storage
FILE_RETENTION_DAYS=7
MAX_UPLOAD_MB=50

# CORS - domain frontend production
FRONTEND_ORIGIN=https://domain-lo.com
